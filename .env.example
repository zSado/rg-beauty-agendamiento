# Claves de las bases de datos locales (docker compose). Copia este archivo como .env.
# Usa valores propios; deben coincidir con los de backend/.env. NUNCA subas .env al repositorio.
POSTGRES_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_ADMIN
RG_APP_PASSWORD=CAMBIA_ESTA_CLAVE_APP
MONGO_PASSWORD=CAMBIA_ESTA_CLAVE_MONGO

# Solo demostración sin MongoDB: portafolio en memoria (se pierde al reiniciar)
# PORTAFOLIO_EN_MEMORIA=true
