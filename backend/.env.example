# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

NODE_ENV=development
PORT=3000

# Usuario de la API: solo lee y escribe datos (no crea ni borra tablas)
DATABASE_URL=postgresql://rg_app:sederikolmos45@ep-billowing-hat-b646t6ta.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Usuario con permiso de crear tablas: solo lo usan los scripts db:migrate y db:reset
DATABASE_ADMIN_URL=postgresql://neondb_owner:sederikolmos45@ep-billowing-hat-b646t6ta.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require
# MongoDB (portafolio). Déjala vacía para ejecutar sin portafolio.
MONGO_URI=mongodb://rg_mongo:CAMBIA_ESTA_CLAVE_MONGO@localhost:27017/?authSource=admin
MONGO_DB=rg_beauty

# Genera valores largos y aleatorios, por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=GENERA_UN_VALOR_ALEATORIO_DE_MAS_DE_32_CARACTERES
PASARELA_SECRET=GENERA_OTRO_VALOR_ALEATORIO

# true cuando se sirve por HTTPS (producción)
COOKIE_SECURE=false
RETENCION_MINUTOS=15

# Solo en producción: carpeta del frontend compilado (la API lo sirve junto con /api)
# FRONTEND_DIST=../frontend/dist

# Contraseña de las cuentas FICTICIAS de demostración (solo para db:seed)
SEED_PASSWORD=CAMBIA_ESTA_CLAVE_DEMO
